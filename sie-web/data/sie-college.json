    },
    "shortName": "SIE-GZNU",
    "affiliation": "贵州师范大学",
    "type": "教学单位（二级学院）",
    "founded": 2014,
    "predecessor": {
      "name": "英国高等教育文凭项目部",
      "founded": 2009
